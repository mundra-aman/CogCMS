{
  "name": "cognerd-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run",
    "test:unit": "node scripts/run-vitest.mjs run --project unit",
    "test:integration": "node scripts/run-vitest.mjs run --project integration",
    "test:watch": "node scripts/run-vitest.mjs",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "ensure:indexes": "tsx --env-file-if-exists=.env scripts/ensure-indexes.ts",
    "ensure:published-views": "tsx --env-file-if-exists=.env scripts/ensure-published-views.ts",
    "import:release-notes": "tsx --env-file-if-exists=.env scripts/import-release-notes.ts",
    "migrate:website": "tsx --env-file-if-exists=.env scripts/migrate-from-website.ts",
    "rerender": "tsx --env-file-if-exists=.env scripts/rerender-all.ts",
    "sync:client": "tsx scripts/sync-client.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/s3-presigned-post": "3.1124.0",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/oidc-aws-credentials-provider": "3.3.5",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "mongoose": "^9.2.3",
    "motion": "12.23.24",
    "next": "^16.0.0",
    "node-html-parser": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-quill-new": "^3.8.3",
    "sharp": "0.35.4",
    "shiki": "^4.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
