# CogCMS — copy to .env and fill in. Never commit .env.

# ── Required for local development ──────────────────────────────────────────
# Your own MongoDB replica set (a standalone mongod breaks transactional paths).
# The project does not supply a database; see README "Local setup".
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=cms_public_demo

# Signs the cms_session cookie. At least 32 characters; generate with: openssl rand -base64 48
CMS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# One-time admin bootstrap, used only by `npm run seed:admin`. Password: at least 12 characters.
CMS_SEED_ADMIN_EMAIL=admin@example.com
CMS_SEED_ADMIN_PASSWORD=
CMS_SEED_ADMIN_NAME=Administrator

# ── Optional: defaults work locally ─────────────────────────────────────────
PORT=3003
# Public origin of this app; also checked against request origins for CSRF protection.
NEXT_PUBLIC_CMS_URL=http://localhost:3003
# Database-backed session lifetimes.
CMS_SESSION_HOURS=12
CMS_SESSION_REMEMBER_DAYS=30

# ── Optional: media uploads (private AWS S3) ────────────────────────────────
# Direct browser upload to private staging, then validated publication.
# Local development uses the SDK default credential chain; never put static keys here.
# Set all three or none (none = uploads disabled). S3_PUBLIC_URL is the CloudFront/custom media origin.
S3_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# ── Hosted installations only (see docs/DEPLOYMENT.md) ──────────────────────
# Use separate preview/production databases and collection-scoped runtime users.
# Comma-separated origins accepted by Next server actions behind a reverse proxy.
CMS_TRUSTED_ORIGINS=
# Leave unset on Vercel (VERCEL=1 is supplied by the platform).
# Off-platform production only: nginx must overwrite X-Real-IP and origin access must be private.
CMS_TRUST_PROXY=
# Vercel media uploads only: required scoped OIDC role; no default-chain fallback when VERCEL=1.
# Role/trust and bucket CORS/lifecycle must be provisioned before enabling hosted uploads.
AWS_ROLE_ARN=

# ── Migration only (see docs/MIGRATION.md); not read by the running app ─────
SOURCE_MONGODB_URI=
RELEASE_NOTES_DIR=
WHITEPAPERS_DIR=
# Optional authoritative JSON array; overrides source FAQs and prunes stale target FAQs.
FAQ_SEED_JSON=
MIGRATION_SITE_SLUG=
MIGRATION_SITE_NAME=
MIGRATION_SITE_ORIGIN=
